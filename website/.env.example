# Copy to website/.env for local builds. Both are optional, and the Deploy workflow sets neither:
# without them the site is built for the production origins in contracts/origins.json (D-20).
# Set one only to build for another address, such as a local server.

# The website's own origin: canonical URLs, hreflang links, the sitemap, robots.txt and llms.txt.
# SITE_URL=http://localhost:4321

# The Flutter web app's address (the app's APP_URL): the "Open the web app" links.
# PUBLIC_APP_URL=http://localhost:8080
