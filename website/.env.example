# Copy to website/.env for local builds; set the same variables in the Vercel project for deploys.
# Both are optional: without them the site uses the Vercel production addresses below.

# The website's own origin: canonical URLs, hreflang links, the sitemap, robots.txt and llms.txt.
SITE_URL=https://maalik-e-makaan-site.vercel.app

# The Flutter web app's address (the app's APP_URL): the "Open the web app" links.
PUBLIC_APP_URL=https://maalik-e-makaan.vercel.app
