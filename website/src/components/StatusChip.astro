---
/**
 * A status in words with an icon, never colour alone (DESIGN.md: status chip).
 * "paid" is settled (a tick); "due-soon" is in progress (a clock); "credit" is
 * information about later (a calendar).
 */
interface Props {
  status: "paid" | "due-soon" | "credit";
  label: string;
}

const { status, label } = Astro.props;
---

<span class:list={["chip", `chip--${status}`]}>
  <svg class="chip__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {status === "credit" ? (
      <>
        <rect
          x="2.25"
          y="3.25"
          width="11.5"
          height="10.5"
          rx="1.5"
          fill="none"
          stroke-width="1.5"
        />
        <path
          d="M2.25 6.75h11.5M5.5 1.75v3M10.5 1.75v3"
          fill="none"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </>
    ) : (
      <circle cx="8" cy="8" r="6.25" fill="none" stroke-width="1.5" />
    )}
    {status === "paid" && (
      <path d="m5.25 8.25 1.9 1.9 3.6-3.9" fill="none" stroke-width="1.5" stroke-linecap="round" />
    )}
    {status === "due-soon" && (
      <path d="M8 4.5V8l2.25 1.5" fill="none" stroke-width="1.5" stroke-linecap="round" />
    )}
  </svg>
  {label}
</span>

<style>
  .chip {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    gap: var(--mm-space-s1);
    padding-block: var(--mm-space-s-half);
    padding-inline: var(--mm-space-s2);
    border: var(--mm-size-hairline) solid transparent;
    border-radius: var(--mm-radius-xs);
    font-size: var(--mm-type-label-size);
    font-weight: var(--mm-type-label-weight);
    line-height: var(--mm-type-label-line);
  }

  :global(html[lang="ur"]) .chip {
    font-size: var(--mm-type-urdu-label-size);
    font-weight: var(--mm-type-urdu-label-weight);
    line-height: var(--mm-type-urdu-label-line);
  }

  .chip--paid {
    background-color: var(--mm-color-paid-container);
    color: var(--mm-color-on-paid-container);
  }

  .chip--due-soon {
    background-color: var(--mm-color-due-soon-container);
    color: var(--mm-color-on-due-soon-container);
  }

  .chip--credit {
    background-color: var(--mm-color-credit-container);
    color: var(--mm-color-on-credit-container);
  }

  .chip__icon {
    flex: none;
    inline-size: 1rem;
    block-size: 1rem;
    stroke: currentcolor;
  }
</style>
