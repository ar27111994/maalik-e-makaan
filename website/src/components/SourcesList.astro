---
/** The official sources a guide or calculator relies on, with the date each was checked. */
import { formatDate } from "../i18n/dates.ts";
import { LOCALE_INFO, type Locale } from "../i18n/locales.ts";
import { scriptAttributes } from "../i18n/script.ts";
import { ui } from "../i18n/ui.ts";
import type { Source } from "../lib/content/schemas.ts";

interface Props {
  locale: Locale;
  sources: readonly Source[];
}

const { locale, sources } = Astro.props;
const strings = ui(locale).guide;
---

<section class="sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">{strings.sources}</h2>
  <ol>
    {sources.map((source) => (
      <li>
        <a href={source.url} {...scriptAttributes(source.title, locale)}>
          {source.title}
        </a>
        {LOCALE_INFO[locale].comma}
        <span {...scriptAttributes(source.publisher, locale)}>{source.publisher}</span> (
        {strings.accessed}:{" "}
        <time datetime={source.accessed}>{formatDate(source.accessed, locale)}</time>)
        {source.url.startsWith("http:") && (
          <span class="sources__insecure"> ({strings.insecure})</span>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .sources__insecure {
    color: var(--mm-color-ink-muted);
  }

  .sources ol {
    display: grid;
    gap: var(--mm-space-s2);
    margin-block-start: var(--mm-space-s3);
    padding-inline-start: var(--mm-space-s6);
  }
</style>
