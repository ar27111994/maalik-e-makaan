---
/**
 * The site's mark: the twin-gables house, filled, on a cobalt tile. Decorative; the site name
 * beside it is the text. In forced colours the tile goes and the house is drawn in the text colour.
 */
import { MARK_GLYPH_PATH, MARK_TILE_RADIUS, MARK_VIEWBOX } from "../lib/brand.ts";
---

<svg class="brand-mark" viewBox={MARK_VIEWBOX} aria-hidden="true" focusable="false">
  <rect class="brand-mark__tile" width="32" height="32" rx={MARK_TILE_RADIUS}></rect>
  <path class="brand-mark__glyph" d={MARK_GLYPH_PATH}></path>
</svg>

<style>
  .brand-mark {
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
  }

  .brand-mark__tile {
    fill: var(--mm-color-primary);
  }

  .brand-mark__glyph {
    fill: var(--mm-color-on-primary);
  }

  @media (forced-colors: active) {
    .brand-mark__tile {
      fill: transparent;
    }

    .brand-mark__glyph {
      fill: currentcolor;
    }
  }
</style>
