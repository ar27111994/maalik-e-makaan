---
import { getEntry } from "astro:content";
import PageHeader from "../components/PageHeader.astro";
import StatusChip from "../components/StatusChip.astro";
import { APP_URL } from "../config/app-url.ts";
import { SITE } from "../config/site.ts";
import { formatDate } from "../i18n/dates.ts";
import type { Locale } from "../i18n/locales.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contentHref } from "../lib/content/links.ts";
import { ids } from "../lib/seo/json-ld.ts";
import { documentTitle } from "../lib/seo/meta.ts";
import { ATTACHED_ASSETS, LATEST_RELEASE, releaseAssets } from "../lib/release.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry("download", locale);
if (entry === undefined) throw new Error(`src/content/download/${locale}.yaml is missing`);
const page = entry.data;
if (Astro.site === undefined) throw new Error("Set `site` in astro.config.ts");
const site = Astro.site;
const release = LATEST_RELEASE;
// Only the files attached to the release when the site was built (src/lib/release.ts).
const files =
  release === undefined ? [] : releaseAssets(release, SITE.repositoryUrl, ATTACHED_ASSETS);
---

<BaseLayout
  locale={locale}
  path="/download/"
  title={documentTitle(page.title, locale)}
  description={page.description}
  pageName={page.title}
  pageExtra={{ about: { "@id": ids.app(site) } }}
  breadcrumbs={[{ label: page.heading, path: "/download/" }]}
>
  <div class="container">
    <PageHeader heading={page.heading} intro={page.intro} />
    {/* WebKit drops the list role when list-style is none; the explicit role keeps it. */}
    {/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles */}
    <ul class="platforms" role="list">
      {page.platforms.map((platform) => (
        <li class="card platforms__item">
          <h2 class="platforms__name">{platform.name}</h2>
          <StatusChip status={platform.available ? "paid" : "planned"} label={platform.status} />
          <p>{platform.body}</p>
        </li>
      ))}
    </ul>
    {release !== undefined && (
      <section class="section release" id="latest-release" aria-labelledby="release-heading">
        <h2 id="release-heading">{page.release.heading.replace("{version}", release.version)}</h2>
        <p>
          <time datetime={release.date}>
            {page.release.date.replace("{date}", formatDate(release.date, locale))}
          </time>
        </p>
        {files.length > 0 && (
          <>
            <h3>{page.release.filesHeading}</h3>
            {/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles */}
            <ul class="release__files" role="list">
              {files.map((file) => (
                <li class="card release__file">
                  <a class="release__link" href={file.url}>
                    {page.release.files[file.id].label}
                  </a>
                  <p>{page.release.files[file.id].note}</p>
                  <p class="release__file-name" dir="ltr" lang="en">
                    {file.file}
                  </p>
                </li>
              ))}
            </ul>
          </>
        )}
        <h3>{page.release.notesHeading}</h3>
        {locale !== "en" && <p class="release__language">{page.release.notesLanguage}</p>}
        <ul class="release__notes" lang={locale === "en" ? undefined : "en"} dir="ltr">
          {release.sections
            .flatMap((section) => section.notes)
            .map((note) => (
              <li>{note.text}</li>
            ))}
        </ul>
        <p>
          <a href={contentHref(page.release.allReleases.href, locale, APP_URL)}>
            {page.release.allReleases.label}
          </a>
          {" · "}
          <a href={release.url}>{page.release.github}</a>
        </p>
      </section>
    )}
    <section class="closing-band" aria-labelledby="web-app-heading">
      <h2 id="web-app-heading">{page.webApp.heading}</h2>
      <p>{page.webApp.body}</p>
      <p class="web-address" dir="ltr" lang="en">
        {APP_URL}
      </p>
      <a class="button button--primary" href={contentHref(page.webApp.cta.href, locale, APP_URL)}>
        {page.webApp.cta.label}
      </a>
    </section>
    <section class="section requirements" aria-labelledby="requirements-heading">
      <h2 id="requirements-heading">{page.requirements.heading}</h2>
      <ul>
        {page.requirements.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--mm-space-s4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platforms__item {
    display: grid;
    align-content: start;
    gap: var(--mm-space-s3);
  }

  .platforms__name {
    font-size: var(--mm-type-title-size);
    font-weight: var(--mm-type-title-weight);
    line-height: var(--mm-type-title-line);
  }

  :global(html[lang="ur"]) .platforms__name {
    font-size: var(--mm-type-urdu-title-size);
    line-height: var(--mm-type-urdu-title-line);
  }

  .release {
    display: grid;
    gap: var(--mm-space-s4);
  }

  .release__files {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--mm-space-s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .release__file {
    display: grid;
    align-content: start;
    gap: var(--mm-space-s2);
  }

  .release__link {
    font-weight: 600;
  }

  .release__file-name {
    overflow-wrap: anywhere;
    color: var(--mm-color-ink-muted);
    font-size: var(--mm-type-body-small-size);
    line-height: var(--mm-type-body-small-line);
  }

  .release__notes {
    display: grid;
    gap: var(--mm-space-s2);
    max-inline-size: var(--reading-max);
    margin: 0;
    padding-inline-start: var(--mm-space-s6);
  }

  .release__language {
    color: var(--mm-color-ink-muted);
  }

  .web-address {
    overflow-wrap: anywhere;
    font-weight: 600;
  }

  .requirements {
    display: grid;
    gap: var(--mm-space-s4);
    max-inline-size: var(--reading-max);
  }

  .requirements ul {
    display: grid;
    gap: var(--mm-space-s2);
    margin: 0;
    padding-inline-start: var(--mm-space-s6);
  }
</style>
