---
import { getCollection } from "astro:content";
import { pairedEntries } from "../lib/content/guides.ts";
import TextPage from "../page-components/TextPage.astro";

/** Pages of running text: /privacy/ and /terms/ (src/content/pages/en/). */
export async function getStaticPaths() {
  return pairedEntries(await getCollection("pages"), "en", "pages").map((entry) => ({
    params: { page: entry.ref.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<TextPage locale="en" entry={entry} />
