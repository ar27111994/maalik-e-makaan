{
  "name": "maalik-e-makaan-website",
  "version": "1.1.1",
  "private": true,
  "description": "The public website of Maalik-e-Makaan (مالکِ مکان): an Astro static site in English and Urdu.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node scripts/serve.ts",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit && npm run lint && prettier --check .",
    "lint": "eslint --max-warnings=0 . && stylelint --max-warnings=0 \"**/*.{css,astro}\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:links": "node scripts/check-links.ts",
    "test:e2e": "npm run test:links && playwright test",
    "lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "lighthouse:ci": "lhci autorun --config=./lighthouserc.ci.cjs",
    "og": "node scripts/generate-og.ts",
    "deck": "node scripts/render-deck.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.2",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.5",
    "subset-font": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "parse5": "8.1.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    },
    "lighthouse": "13.6.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "basic-ftp": "6.2.3",
    "minimatch@>=10.0.0 <11.0.1": "11.0.3",
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "playwright-core": "1.64.1"
  }
}
