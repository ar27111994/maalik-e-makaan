# Edge Function secrets. Copy to supabase/functions/.env for local development
# (`supabase start` / `supabase functions serve` load it); set production values
# with `supabase secrets set` or in the dashboard (Edge Functions → Secrets).
# SUPABASE_URL, the API keys and the JWKS are provided by the platform.
# See supabase/functions/_shared/config.ts for validation rules.

# Public URL of the app; invitation links open here (https, or http for localhost).
APP_URL=http://127.0.0.1:8080

# Browser origins allowed to call the functions. Defaults to APP_URL's origin.
# ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Invitation e-mails through Resend (https://resend.com). Leave unset to share
# invitation links manually (WhatsApp) instead.
# RESEND_API_KEY=
# MAIL_FROM=Maalik-e-Makaan <invites@your-domain.example>
# MAIL_REPLY_TO=support@your-domain.example

# At least 32 random characters; enables GET /health?deep=1 for monitors.
# HEALTH_CHECK_TOKEN=

# How recent a sign-in must be to delete an account (60–3600 seconds).
# REAUTH_MAX_AGE_SECONDS=600
