{
  "workspace": [
    "./delete-account",
    "./invite-member",
    "./health"
  ],
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "imports": {
    "@supabase/server": "npm:@supabase/server@1.9.2",
    "@supabase/server/core": "npm:@supabase/server@1.9.2/core",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing/mock": "jsr:@std/testing@1.0.21/mock"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "eqeqeq",
        "explicit-module-boundary-types",
        "no-console",
        "no-eval",
        "no-throw-literal",
        "no-non-null-assertion"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "test": "deno test --allow-env --allow-net=127.0.0.1,localhost --allow-read=. --coverage=coverage --clean && deno coverage coverage --lcov --output=coverage/lcov.info --exclude=tests/",
    "test:e2e": "MM_FUNCTIONS_E2E=1 deno test --allow-env --allow-net tests/e2e/",
    "check": "deno check _shared delete-account invite-member health tests",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "coverage": "deno coverage coverage --exclude=tests/"
  },
  "test": {
    "include": [
      "tests/"
    ]
  },
  "exclude": [
    "coverage/"
  ]
}
