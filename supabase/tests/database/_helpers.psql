-- Shared pgTAP helpers, included by every suite with `\ir _helpers.psql`.
-- They are created inside each test transaction and disappear on ROLLBACK.
-- (The .psql extension keeps pg_prove from running this file as a test.)

create extension if not exists pgtap with schema extensions;
create schema if not exists tests;
grant usage on schema tests to anon, authenticated, service_role;

-- Creates an auth user (e-mail verified unless p_verified is false).
create or replace function tests.create_user(p_email text, p_verified boolean default true)
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, email, email_confirmed_at, raw_user_meta_data)
  values (v_id, p_email, case when p_verified then now() end,
          jsonb_build_object('full_name', split_part(p_email, '@', 1)));
  return v_id;
end
$$;

create or replace function tests.user_email(p_user_id uuid)
returns text
language sql
stable
security definer
set search_path = ''
as $$
  select u.email from auth.users u where u.id = p_user_id
$$;

-- Switches the session to an authenticated user, exactly as PostgREST does.
-- (Not SECURITY DEFINER: the role can only be changed by the caller.)
create or replace function tests.authenticate_as(p_user_id uuid)
returns void
language plpgsql
set search_path = ''
as $$
begin
  perform set_config('request.jwt.claims', json_build_object(
    'sub', p_user_id, 'role', 'authenticated', 'email', tests.user_email(p_user_id)
  )::text, true);
  perform set_config('role', 'authenticated', true);
end
$$;

create or replace function tests.authenticate_as_anon()
returns void
language plpgsql
set search_path = ''
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('role', 'anon', true);
end
$$;

create or replace function tests.authenticate_as_service_role()
returns void
language plpgsql
set search_path = ''
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  perform set_config('role', 'service_role', true);
end
$$;

-- Back to the migration owner (bypasses RLS) for arranging fixtures.
create or replace function tests.clear_authentication()
returns void
language plpgsql
set search_path = ''
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end
$$;

-- Creates a portfolio owned by p_owner (bypassing the RPC rate limits).
create or replace function tests.create_portfolio(p_owner uuid, p_name text default 'Test Portfolio')
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid;
begin
  insert into public.portfolios (name, created_by) values (p_name, p_owner) returning id into v_id;
  insert into public.portfolio_members (portfolio_id, user_id, role) values (v_id, p_owner, 'owner');
  return v_id;
end
$$;

create or replace function tests.add_member(p_portfolio_id uuid, p_user_id uuid, p_role public.member_role)
returns void
language sql
security definer
set search_path = ''
as $$
  insert into public.portfolio_members (portfolio_id, user_id, role) values (p_portfolio_id, p_user_id, p_role)
$$;

-- A property with one unit and one tenant. Returns the ids as JSON.
create or replace function tests.create_rental(
  p_portfolio_id uuid,
  p_province public.province default 'punjab',
  p_label text default 'Upper portion'
)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_property uuid;
  v_unit uuid;
  v_tenant uuid;
begin
  insert into public.properties (portfolio_id, name, city, province)
  values (p_portfolio_id, 'House ' || left(gen_random_uuid()::text, 8), 'Lahore', p_province)
  returning id into v_property;
  insert into public.units (portfolio_id, property_id, label, asking_rent)
  values (p_portfolio_id, v_property, p_label, 45000)
  returning id into v_unit;
  insert into public.tenants (portfolio_id, full_name, phone)
  values (p_portfolio_id, 'Tenant ' || left(gen_random_uuid()::text, 8), '+923001234567')
  returning id into v_tenant;
  return jsonb_build_object('property_id', v_property, 'unit_id', v_unit, 'tenant_id', v_tenant);
end
$$;

-- Creates an active lease; extra columns can be overridden through p_overrides.
create or replace function tests.create_lease(
  p_portfolio_id uuid,
  p_rental jsonb,
  p_start date,
  p_rent numeric default 45000,
  p_overrides jsonb default '{}'::jsonb
)
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_row jsonb := jsonb_build_object(
    'portfolio_id', p_portfolio_id,
    'unit_id', p_rental ->> 'unit_id',
    'tenant_id', p_rental ->> 'tenant_id',
    'start_date', p_start,
    'monthly_rent', p_rent
  ) || p_overrides;
  v_id uuid;
begin
  insert into public.leases
  select * from jsonb_populate_record(null::public.leases, v_row || jsonb_build_object(
    'id', coalesce(v_row ->> 'id', gen_random_uuid()::text),
    'status', coalesce(v_row ->> 'status', 'active'),
    'rent_due_day', coalesce((v_row ->> 'rent_due_day')::integer, 5),
    'grace_days', coalesce((v_row ->> 'grace_days')::integer, 5),
    'security_deposit', coalesce((v_row ->> 'security_deposit')::numeric, 0),
    'increment_percent', coalesce((v_row ->> 'increment_percent')::numeric, 10),
    'increment_interval_months', coalesce((v_row ->> 'increment_interval_months')::integer, 12),
    'late_fee_type', coalesce(v_row ->> 'late_fee_type', 'none'),
    'prorate_first_month', coalesce((v_row ->> 'prorate_first_month')::boolean, true),
    'notice_period_days', coalesce((v_row ->> 'notice_period_days')::integer, 30),
    'subletting_allowed', false,
    'rent_registrar_status', 'not_presented',
    'police_status', coalesce(v_row ->> 'police_status', 'pending'),
    'created_at', now(),
    'updated_at', now()
  ))
  returning id into v_id;
  return v_id;
end
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
