# ───────────────────────── Secrets & local env ─────────────────────────
# Never commit real credentials. Copy the *.example files instead.
.env
.env.*
!.env.example
!**/.env.example
*.env
!*.env.example
**/config/*.local.json
app/config/*.json
!app/config/*.example.json
*.pem
*.p12
*.jks
*.keystore
key.properties
service-account*.json
google-services.json
GoogleService-Info.plist

# ───────────────────────── Dart / Flutter ─────────────────────────
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
build/
coverage/
# ...but not the coverage gate tool itself.
!/tool/coverage/
*.symbols
app.*.map.json
.widget_preview/
migrate_working_dir/
**/failures/
# Golden-test diff output (the approved goldens themselves ARE committed).
**/test/**/failures/
# Library packages do not commit their own lockfile; the workspace root does.
packages/*/pubspec.lock
app/pubspec.lock

