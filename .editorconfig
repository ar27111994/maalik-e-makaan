# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,gradle,java,swift,m,h,cc,cpp,cmake}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.sh]
# shfmt (https://github.com/mvdan/sh) reads these.
shell_variant = bash
binary_next_line = true
switch_case_indent = true

[*.py]
indent_size = 4
